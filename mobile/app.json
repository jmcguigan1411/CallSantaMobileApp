{
  "expo": {
    "name": "Call Santa",
    "slug": "mobile",
    "scheme": "callsanta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#b71c1c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.callsanta.callsanta",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.callsanta.callsanta",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#b71c1c"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow Call Santa to access your microphone for Santa calls"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0e3db780-8e98-4250-a48f-da45138286a4"
      }
    }
  }
}
